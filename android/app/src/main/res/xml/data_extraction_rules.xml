<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ replaces android:allowBackup / android:fullBackupContent
  with this file. The empty rules explicitly opt OUT of cloud backup
  AND device-to-device transfer for *all* app data, including the
  PouchDB IndexedDB cache and shared-preferences (where Capacitor
  plugins persist things like the auth state).

  If you ever want selective backup, list <include>/<exclude> rules
  here. For now: nothing leaves the device.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </device-transfer>
</data-extraction-rules>
